# 애플리케이션 실행 모드: local, test, production 중 하나를 입력합니다.
APP_ENV=local

# 로그 상세도: DEBUG, INFO, WARNING, ERROR 중 하나를 입력합니다.
LOG_LEVEL=INFO

# 실제 텔레그램 발송 여부입니다. 초기 개발/검증 중에는 false를 유지하세요.
ENABLE_TELEGRAM_PUBLISH=false

# 외부 발송과 쓰기 작업을 막는 안전 모드입니다. 운영 발송 전까지 true를 유지하세요.
DRY_RUN=true

# 사용자 입력 필요: Supabase 프로젝트 URL입니다.
SUPABASE_URL=

# 사용자 입력 필요: Supabase publishable/anon key입니다. 초기 서버 배치에는 선택값입니다.
SUPABASE_ANON_KEY=

# 사용자 입력 필요: SQLAlchemy/Alembic에서 사용할 Supabase PostgreSQL 접속 문자열입니다.
SUPABASE_DATABASE_URL=

# 사용자 입력 필요: Telegram BotFather에서 발급받은 봇 토큰입니다.
TELEGRAM_BOT_TOKEN=

# 사용자 입력 필요: 알림을 보낼 Telegram 채널 또는 채팅 ID입니다.
TELEGRAM_CHANNEL_ID=

# 사용자 입력 필요: 이벤트 요약/분류에 사용할 OpenAI API 키입니다.
OPENAI_API_KEY=

# 앞으로 며칠 이내의 주말 이벤트를 알림 대상으로 볼지 정합니다.
ALERT_LOOKAHEAD_DAYS=14

# 텔레그램 메시지 하나에 포함할 최대 이벤트 수입니다.
MAX_EVENTS_PER_MESSAGE=5

# HTTP 요청 타임아웃 초 단위입니다.
REQUEST_TIMEOUT_SECONDS=15

# 크롤러 요청 실패 시 재시도 횟수입니다.
CRAWLER_MAX_RETRIES=2
